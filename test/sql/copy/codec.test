# name: test/sql/copy/codec.test
# description: COPY ... TO (FORMAT AVRO, CODEC '...') compresses every block with the codec and round-trips
# group: [copy]

require avro

statement ok
CREATE TABLE src AS SELECT
	i AS a,
	'row_' || (i % 4)::VARCHAR AS b,
	CASE WHEN i % 3 = 0 THEN NULL ELSE [i, NULL, i + 1] END AS c,
	{'x': i % 7, 'y': repeat('y', i % 50)} AS d
FROM range(20000) t(i);

# The default (no CODEC) writes uncompressed blocks.
statement ok
COPY src TO '{TEST_DIR}/codec_default.avro' (FORMAT AVRO);

query I
SELECT value FROM avro_metadata('{TEST_DIR}/codec_default.avro') WHERE key = 'avro.codec';
----
null

foreach codec null deflate snappy zstandard

statement ok
COPY src TO '{TEST_DIR}/codec_{codec}.avro' (FORMAT AVRO, CODEC '{codec}');

query I
SELECT value = '{codec}' FROM avro_metadata('{TEST_DIR}/codec_{codec}.avro') WHERE key = 'avro.codec';
----
true

query III
SELECT count(*), sum(a), sum(len(c)) FROM read_avro('{TEST_DIR}/codec_{codec}.avro');
----
20000	199990000	39999

query I
SELECT count(*) FROM (SELECT * FROM src EXCEPT SELECT * FROM read_avro('{TEST_DIR}/codec_{codec}.avro'));
----
0

query I
SELECT count(*) FROM (SELECT * FROM read_avro('{TEST_DIR}/codec_{codec}.avro') EXCEPT SELECT * FROM src);
----
0

endloop

query I
SELECT count(*) FROM (SELECT * FROM src EXCEPT SELECT * FROM read_avro('{TEST_DIR}/codec_default.avro'));
----
0

# Case-insensitive codec name.
statement ok
COPY (select 1 a) TO '{TEST_DIR}/codec_ci.avro' (FORMAT AVRO, CODEC 'DEFLATE');

query I
select a from read_avro('{TEST_DIR}/codec_ci.avro');
----
1

statement error
COPY (select 1 a) TO '{TEST_DIR}/codec_bad.avro' (FORMAT AVRO, CODEC 'nope');
----
Unknown codec

statement error
COPY (select 1 a) TO '{TEST_DIR}/codec_empty.avro' (FORMAT AVRO, CODEC);
----
CODEC can not be provided without a value
