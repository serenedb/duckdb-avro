# name: test/sql/copy/nullable.test
# group: [copy]

require avro

# copy null into a field (type unioned with null)
statement ok
COPY (
	select NULL field1
) TO '{TEST_DIR}/field_ids_1.avro' (
	FIELD_IDS {
		'field1': {'__duckdb_field_id': 301},
	},
	ROOT_NAME 'test'
);

# copy null into a field (type unioned with null)
statement ok
COPY (
	select NULL field1
) TO '{TEST_DIR}/field_ids_1_nullable.avro' (
	FIELD_IDS {
		'field1': {'__duckdb_field_id': 301, '__duckdb_nullable': true},
	},
	ROOT_NAME 'test'
);

# insert null into non-nullable field
statement error
COPY (
	select NULL::INTEGER field1
) TO '{TEST_DIR}/field_ids_error.avro' (
	FIELD_IDS {
		'field1': {'__duckdb_field_id': 301, '__duckdb_nullable': false},
	},
	ROOT_NAME 'test'
);
----
<REGEX>:.*Cannot insert NULL to non-nullable field.*

# Failed COPY removes its output
statement error
select * from read_avro('{TEST_DIR}/field_ids_error.avro');
----
<REGEX>:.*No files found that match the pattern.*

# cannot cast foo to BOOL
statement error
COPY (
	select NULL field1
) TO '{TEST_DIR}/field_ids_error.avro' (
	FIELD_IDS {
		'field1': {'__duckdb_field_id': 301, '__duckdb_nullable': 'foo'},
	},
	ROOT_NAME 'test'
);
----
<REGEX>:.*Invalid Input Error: Failed to cast value:.*

# test different ways to set a field id
# via a struct
# directly
statement ok
COPY (
	select 1 field1, 2 field2, 3 field3
) TO '{TEST_DIR}/field_ids_2.avro' (
	FIELD_IDS {
		'field1': {'__duckdb_field_id': 301, '__duckdb_nullable': false},
		'field2': 303,
	},
	ROOT_NAME 'test'
);

# read
query III
select * from read_avro('{TEST_DIR}/field_ids_2.avro');
----
1	2	3


# items in structs can also be nullable
statement ok
COPY (
	select
          1 manifest_entry,
          {
          	'content': 1,
          } data_file_not_nullable,
) TO '{TEST_DIR}/field_ids_3.avro' (
	FIELD_IDS {
		'manifest_entry': 0,
		'data_file_not_nullable': {
		    '__duckdb_field_id': 1,
		    '__duckdb_nullable': false,
		    'content': {
		        '__duckdb_field_id': 2,
		        '__duckdb_nullable': false
		    }
		}
	},
	ROOT_NAME 'test'
);

statement ok
create table t1 as select
1 manifest_entry,
{
	'content': 1,
} data_file_not_nullable,
{
	'content': 2,
} data_file_nullable;

statement ok
COPY t1 TO '{TEST_DIR}/field_ids_4.avro' (
	FIELD_IDS {
		'manifest_entry': {
			'__duckdb_field_id': 0
		},
		'data_file_not_nullable': {
		    	'__duckdb_field_id': 2,
		    	'__duckdb_nullable': false,
		    	'content': 3
		},
        'data_file_nullable': {
                '__duckdb_field_id': 4,
                'content': 5
        }
	},
	ROOT_NAME 'manifest_entry'
);

query III
select * from read_avro('{TEST_DIR}/field_ids_4.avro');
----
1	{'content': 1}	{'content': 2}

# nested nullable field throws error
statement error
COPY (select
      1 manifest_entry,
      {
      	'content': 1,
      } data_file_not_nullable,
      {
      	'content': NULL::INTEGER,
      } data_file_nullable
) TO '{TEST_DIR}/field_ids_5.avro' (
	FIELD_IDS {
		'manifest_entry': {
			'__duckdb_field_id': 0
		},
		'data_file_not_nullable': {
		    	'__duckdb_field_id': 2,
		    	'__duckdb_nullable': false,
		    	'content': {
		    	    '__duckdb_field_id': 3,
		    	    '__duckdb_nullable': false
		    	}
		},
        'data_file_nullable': {
                '__duckdb_field_id': 4,
                'content': {
                    '__duckdb_field_id': 5,
                    '__duckdb_nullable': false
                }
        }
	},
	ROOT_NAME 'manifest_entry'
);
----
<REGEX>:.*Cannot insert NULL to non-nullable field.*

# other nested types
statement ok
COPY (select
      	MAP {
      		21: 'abc',
      		42: 'test'
      	} "field_map",
      	[
      		'a',
      		'b',
      		'c'
      	] "field_list",
      	{
      		'a': 21,
      		'b': True,
      		'c': 1.234::FLOAT
      	} "field_struct"
) TO '{TEST_DIR}/nested_field_types.avro' (
	FIELD_IDS {
		'field_map': {
		    'key': 0,
		    'value': 1,
		    '__duckdb_field_id': 2,
		    '__duckdb_nullable': false
		},
		'field_list': {
		    'list': 3,
		    '__duckdb_field_id': 4,
		    '__duckdb_nullable': false
		},
		'field_struct': {
		    'a': 5,
		    'b': 6,
		    'c': 7,
			'__duckdb_field_id': 507,
			'__duckdb_nullable': false
		}
	},
	ROOT_NAME 'manifest_file'
);

# a NULL struct writes no fields, so its non-nullable fields are not checked
statement ok
COPY (
	SELECT i AS id, CASE WHEN i % 2 = 0 THEN NULL ELSE {'content': i::INTEGER} END AS data_file FROM range(4) t(i)
) TO '{TEST_DIR}/null_struct_required_field.avro' (
	FIELD_IDS {
		'data_file': {
			'__duckdb_field_id': 1,
			'content': {'__duckdb_field_id': 2, '__duckdb_nullable': false}
		}
	},
	ROOT_NAME 'manifest_entry'
);

query III
SELECT id, data_file IS NULL, data_file.content FROM read_avro('{TEST_DIR}/null_struct_required_field.avro') ORDER BY id;
----
0	true	NULL
1	false	1
2	true	NULL
3	false	3

# a NULL list writes no elements, so its non-nullable elements are not checked
statement ok
COPY (
	SELECT i AS id, CASE WHEN i % 2 = 0 THEN NULL ELSE [i::INTEGER, i::INTEGER + 1] END AS l FROM range(4) t(i)
) TO '{TEST_DIR}/null_list_required_element.avro' (
	FIELD_IDS {
		'l': {'__duckdb_field_id': 1, 'list': {'__duckdb_field_id': 2, '__duckdb_nullable': false}}
	}
);

query II
SELECT id, l FROM read_avro('{TEST_DIR}/null_list_required_element.avro') ORDER BY id;
----
0	NULL
1	[1, 2]
2	NULL
3	[3, 4]

# a NULL element of a list that is written is rejected
statement error
COPY (SELECT [1, NULL]::INTEGER[] AS l) TO '{TEST_DIR}/null_required_element.avro' (
	FIELD_IDS {
		'l': {'__duckdb_field_id': 1, 'list': {'__duckdb_field_id': 2, '__duckdb_nullable': false}}
	}
);
----
Cannot insert NULL to non-nullable field of type INTEGER

# the first row holding a rejected NULL names the error, then the first such column in it
statement error
COPY (SELECT * FROM (VALUES (1, NULL), (NULL, 'x')) t(a, b)) TO '{TEST_DIR}/null_first_row.avro' (
	FIELD_IDS {
		'a': {'__duckdb_field_id': 1, '__duckdb_nullable': false},
		'b': {'__duckdb_field_id': 2, '__duckdb_nullable': false}
	}
);
----
Cannot insert NULL to non-nullable field of type VARCHAR

statement error
COPY (SELECT * FROM (VALUES (NULL, 'x'), (1, NULL)) t(a, b)) TO '{TEST_DIR}/null_first_column.avro' (
	FIELD_IDS {
		'a': {'__duckdb_field_id': 1, '__duckdb_nullable': false},
		'b': {'__duckdb_field_id': 2, '__duckdb_nullable': false}
	}
);
----
Cannot insert NULL to non-nullable field of type INTEGER

# a NULL struct or list in a non-nullable column is rejected as that type
statement error
COPY (SELECT NULL::STRUCT(a INTEGER) AS s) TO '{TEST_DIR}/null_struct.avro' (
	FIELD_IDS {'s': {'__duckdb_field_id': 1, '__duckdb_nullable': false}}
);
----
Cannot insert NULL to non-nullable field of type STRUCT

statement error
COPY (SELECT NULL::INTEGER[] AS l) TO '{TEST_DIR}/null_list.avro' (
	FIELD_IDS {'l': {'__duckdb_field_id': 1, '__duckdb_nullable': false}}
);
----
Cannot insert NULL to non-nullable field of type LIST

# a struct is rejected by its first non-nullable field holding a NULL, whatever its later fields hold
statement error
COPY (SELECT {'a': NULL::INTEGER, 'b': NULL::VARCHAR} AS s) TO '{TEST_DIR}/null_fields.avro' (
	FIELD_IDS {
		's': {
			'__duckdb_field_id': 1,
			'a': {'__duckdb_field_id': 2, '__duckdb_nullable': false},
			'b': {'__duckdb_field_id': 3, '__duckdb_nullable': false}
		}
	}
);
----
Cannot insert NULL to non-nullable field of type INTEGER

# only the lists holding a rejected element are rejected, whether that element is before, inside or after them
statement error
COPY (SELECT * FROM (VALUES ([1, 2]), ([NULL, 3]), ([4])) t(l)) TO '{TEST_DIR}/null_element_lists.avro' (
	FIELD_IDS {
		'l': {'__duckdb_field_id': 1, 'list': {'__duckdb_field_id': 2, '__duckdb_nullable': false}}
	}
);
----
Cannot insert NULL to non-nullable field of type INTEGER

# a column or nested value of type NULL is written as the null schema itself: a union may hold null only once
statement ok
COPY (SELECT NULL AS x, 1 AS y, [NULL, NULL] AS l, {'n': NULL, 'v': 2} AS s) TO '{TEST_DIR}/null_typed.avro';

query I
SELECT value FROM avro_metadata('{TEST_DIR}/null_typed.avro') WHERE key = 'avro.schema';
----
{"type":"record","name":"root","fields":[{"name":"x","type":"null"},{"name":"y","type":["null","int"]},{"name":"l","type":["null",{"type":"array","items":"null"}]},{"name":"s","type":["null",{"type":"record","name":"s","fields":[{"name":"n","type":"null"},{"name":"v","type":["null","int"]}]}]}]}

query IIII
SELECT * FROM read_avro('{TEST_DIR}/null_typed.avro');
----
NULL	1	[NULL, NULL]	{'n': NULL, 'v': 2}
