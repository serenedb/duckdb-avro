# name: test/sql/copy/invalid_name.test
# group: [copy]

require avro

statement error
COPY (select range(10000) AS "range(10000)") TO '{TEST_DIR}/tmp.avro';
----
Invalid Avro identifier "range(10000)": field names have to match the regex [A-Za-z_][A-Za-z0-9_]*, or set SANITIZE_FIELD_NAMES

statement error
COPY (SELECT 1 AS "1col") TO '{TEST_DIR}/tmp.avro';
----
Invalid Avro identifier "1col": field names have to match the regex [A-Za-z_][A-Za-z0-9_]*, or set SANITIZE_FIELD_NAMES

statement error
COPY (SELECT 1 AS a) TO '{TEST_DIR}/tmp.avro' (ROOT_NAME '');
----
'' is not a valid Avro identifier
