statement ok
COPY (SELECT avro_header('{"type":"bytes","logicalType":"decimal","precision":39,"scale":2}')) TO '{TEST_DIR}/schema_wide_decimal.avro' (FORMAT BLOB)

statement error
FROM read_avro('{TEST_DIR}/schema_wide_decimal.avro')
----
Avro decimal precision 39 is larger than the supported maximum of 38

statement ok
COPY (SELECT avro_header('{"type":"long","logicalType":"timestamp-nanos","adjust-to-utc":true}')) TO '{TEST_DIR}/schema_utc_nanos.avro' (FORMAT BLOB)

statement error
FROM read_avro('{TEST_DIR}/schema_utc_nanos.avro')
----
Avro timestamp-nanos with adjust_to_utc not supported
