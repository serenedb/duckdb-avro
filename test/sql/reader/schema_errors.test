# name: test/sql/reader/schema_errors.test
# description: read_avro rejects a file whose schema is not JSON, misses a required attribute, names an unknown type or uses an unsupported logical type
# group: [reader]

require avro

statement ok
CREATE MACRO avro_long(n) AS from_hex(CASE
	WHEN n < 64 THEN printf('%02x', 2 * n)
	WHEN n < 8192 THEN printf('%02x%02x', 2 * n % 128 + 128, 2 * n // 128)
	WHEN n < 1048576 THEN printf('%02x%02x%02x', 2 * n % 128 + 128, 2 * n // 128 % 128 + 128, 2 * n // 16384)
	ELSE printf('%02x%02x%02x%02x', 2 * n % 128 + 128, 2 * n // 128 % 128 + 128, 2 * n // 16384 % 128 + 128, 2 * n // 2097152)
END)

statement ok
CREATE MACRO avro_header(schema_text) AS 'Obj\x01\x02\x16avro.schema'::BLOB || avro_long(strlen(schema_text)) || encode(schema_text) || '\x00\x5D\x4E\x1A\xC0\xFF\xEE\x7A\x1B\x2C\x3D\x4E\x5F\x60\x71\x82\x93'::BLOB

statement ok
COPY (SELECT avro_header('{"type":')) TO '{TEST_DIR}/schema_not_json.avro' (FORMAT BLOB)

statement error
FROM read_avro('{TEST_DIR}/schema_not_json.avro')
----
Avro schema is not valid JSON

statement ok
COPY (SELECT avro_header('5')) TO '{TEST_DIR}/schema_number.avro' (FORMAT BLOB)

statement error
FROM read_avro('{TEST_DIR}/schema_number.avro')
----
Invalid Avro schema: a type must be a string, an object or an array

statement ok
COPY (SELECT avro_header('{"name":"r"}')) TO '{TEST_DIR}/schema_without_type.avro' (FORMAT BLOB)

statement error
FROM read_avro('{TEST_DIR}/schema_without_type.avro')
----
Invalid Avro schema: "type" field must be a string

statement ok
COPY (SELECT avro_header('{"type":5}')) TO '{TEST_DIR}/schema_number_type.avro' (FORMAT BLOB)

statement error
FROM read_avro('{TEST_DIR}/schema_number_type.avro')
----
Invalid Avro schema: "type" field must be a string

statement ok
COPY (SELECT avro_header('"record"')) TO '{TEST_DIR}/schema_record_string.avro' (FORMAT BLOB)

statement error
FROM read_avro('{TEST_DIR}/schema_record_string.avro')
----
Invalid Avro schema: a record type must be an object

statement ok
COPY (SELECT avro_header('"array"')) TO '{TEST_DIR}/schema_array_string.avro' (FORMAT BLOB)

statement error
FROM read_avro('{TEST_DIR}/schema_array_string.avro')
----
Invalid Avro schema: an array type must be an object

