# name: test/sql/reader/corrupt_blocks.test
# description: read_avro rejects a block that does not decompress, is framed by a count, size or sync marker it cannot read, or holds more data than its records; it skips a block without records and cannot number more than 2^24 records of a block
# group: [reader]

require avro

statement error
FROM read_avro('test/reader/corrupt_deflate.avro')
----
Avro file "test/reader/corrupt_deflate.avro" is corrupt at the block at offset 240: Avro deflate block is corrupt: invalid block type

statement error
FROM read_avro('test/reader/corrupt_deflate_end.avro')
----
Avro file "test/reader/corrupt_deflate_end.avro" is corrupt at the block at offset 198: Avro deflate block is corrupt: the compressed data ends early

statement error
FROM read_avro('test/reader/corrupt_snappy_short.avro')
----
Avro file "test/reader/corrupt_snappy_short.avro" is corrupt at the block at offset 197: Avro snappy block is corrupt: the block is shorter than its checksum

statement error
FROM read_avro('test/reader/corrupt_snappy_length.avro')
----
Avro file "test/reader/corrupt_snappy_length.avro" is corrupt at the block at offset 197: Avro snappy block is corrupt: invalid uncompressed length

statement error
FROM read_avro('test/reader/corrupt_snappy_data.avro')
----
Avro file "test/reader/corrupt_snappy_data.avro" is corrupt at the block at offset 197: Avro snappy block is corrupt: invalid compressed data

statement error
FROM read_avro('test/reader/corrupt_snappy_checksum.avro')
----
Avro file "test/reader/corrupt_snappy_checksum.avro" is corrupt at the block at offset 197: Avro snappy block is corrupt: CRC32 checksum mismatch

statement error
FROM read_avro('test/reader/corrupt_zstandard.avro')
----
Avro file "test/reader/corrupt_zstandard.avro" is corrupt at the block at offset 200: Avro zstandard block is corrupt: Unknown frame descriptor

statement error
FROM read_avro('test/reader/corrupt_zstandard_end.avro')
----
Avro file "test/reader/corrupt_zstandard_end.avro" is corrupt at the block at offset 200: Avro zstandard block is corrupt: the compressed data ends early

statement error
FROM read_avro('test/reader/corrupt_zstandard_content_size.avro')
----
Avro file "test/reader/corrupt_zstandard_content_size.avro" is corrupt at the block at offset 144: Avro zstandard block is corrupt: Data corruption detected

statement error
FROM read_avro('test/reader/corrupt_snappy_declared_length.avro')
----
Avro file "test/reader/corrupt_snappy_declared_length.avro" is corrupt at the block at offset 197: Avro snappy block is corrupt: invalid uncompressed length

query II
SELECT id, length(word) FROM read_avro('test/reader/codec_snappy_runs.avro')
----
0	60000

# a scan that decodes no column does not decompress its blocks
query I
SELECT count(*) FROM read_avro('test/reader/corrupt_deflate.avro')
----
10

statement error
FROM read_avro('test/reader/corrupt_block_count_malformed.avro')
----
<REGEX>:.*corrupt_block_count_malformed\.avro" is corrupt at the block at offset 237: a block is truncated or does not end with the file's sync marker.*

