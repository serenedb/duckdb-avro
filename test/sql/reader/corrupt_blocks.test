query II
SELECT id, word FROM read_avro('test/reader/empty_block.avro')
----
0	a
1	b
2	c

query I
SELECT count(*) FROM read_avro('test/reader/block_trailing_bytes.avro')
----
2

statement error
SELECT id FROM read_avro('test/reader/block_trailing_bytes.avro')
----
Avro file "test/reader/block_trailing_bytes.avro" is corrupt at the block at offset 195: the records of a block do not fill its data

query I
SELECT count(*) FROM read_avro('test/reader/block_many_records.avro')
----
16777217

statement error
SELECT max(file_row_number) FROM read_avro('test/reader/block_many_records.avro')
----
Avro file "test/reader/block_many_records.avro" has a block at offset 142 that file_row_number cannot address: blocks must start below 549755813888 and hold at most 16777216 records
