# name: test/sql/reader/malformed_records.test
# description: read_avro rejects a record holding a number, length, value or array count it cannot read, whether it decodes or skips the field, and a value its type cannot hold once it decodes it, also only for the rows a filter keeps
# group: [reader]

require avro

statement error
SELECT n FROM read_avro('test/reader/malformed_long.avro')
----
Avro file "test/reader/malformed_long.avro" is corrupt at the block at offset 171: a number is malformed or runs past the end of its block

statement error
SELECT id FROM read_avro('test/reader/malformed_long.avro')
----
<REGEX>:.*malformed_long\.avro" is corrupt at the block at offset 171: a number is malformed\n

statement error
SELECT n FROM read_avro('test/reader/long_past_end.avro')
----
Avro file "test/reader/long_past_end.avro" is corrupt at the block at offset 170: a number is malformed or runs past the end of its block

statement error
SELECT id FROM read_avro('test/reader/long_past_end.avro')
----
Avro file "test/reader/long_past_end.avro" is corrupt at the block at offset 170: a number runs past the end of its block

statement error
SELECT s FROM read_avro('test/reader/negative_length.avro')
----
Avro file "test/reader/negative_length.avro" is corrupt at the block at offset 174: a length is negative or runs past the end of its block

statement error
SELECT s FROM read_avro('test/reader/length_past_end.avro')
----
Avro file "test/reader/length_past_end.avro" is corrupt at the block at offset 174: a length is negative or runs past the end of its block

statement error
