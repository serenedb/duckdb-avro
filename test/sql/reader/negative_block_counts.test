# name: test/sql/reader/negative_block_counts.test
# description: read_avro reads arrays and maps split into several blocks, also with negative counts followed by the block size
# group: [reader]

require avro

query II
SELECT column_name, column_type FROM (DESCRIBE FROM read_avro('test/reader/negative_block_counts.avro'))
----
id	INTEGER
ints	INTEGER[]
words	MAP(VARCHAR, VARCHAR)
grid	BIGINT[][]
tail	VARCHAR

query IIIIII
SELECT id, len(ints), list_sum(ints), words, grid, tail FROM read_avro('test/reader/negative_block_counts.avro') ORDER BY id
----
0	6	21	{a=x, b=yy, c=zzz}	[[10, 20], [], [30]]	end0
1	0	NULL	{}	[]	end1
2	1000	499500	{k=v, l=w, m=x}	[[-1, -2, -3], [9223372036854775807], [-9223372036854775808]]	end2
3	3	24	{only=one}	[[], [5]]	end3

query II
SELECT id, ints FROM read_avro('test/reader/negative_block_counts.avro') WHERE id <> 2 ORDER BY id
----
0	[1, 2, 3, 4, 5, 6]
1	[]
3	[7, 8, 9]

query III
SELECT ints[1], ints[500], ints[1000] FROM read_avro('test/reader/negative_block_counts.avro') WHERE id = 2
----
0	499	999
