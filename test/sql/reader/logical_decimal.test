# name: test/sql/reader/logical_decimal.test
# description: read_avro reads decimals on bytes and on fixed, minimal and wider than needed, with precision 4, 9, 18 and 38
# group: [reader]

require avro

query II
SELECT column_name, column_type FROM (DESCRIBE FROM read_avro('test/reader/logical_decimal_bytes.avro'))
----
id	INTEGER
b4_0	DECIMAL(4,0)
b4_2	DECIMAL(4,2)
b9_4	DECIMAL(9,4)
b9_9	DECIMAL(9,9)
b18_0	DECIMAL(18,0)
b18_6	DECIMAL(18,6)
b38_0	DECIMAL(38,0)
b38_10	DECIMAL(38,10)
b38_38	DECIMAL(38,38)

