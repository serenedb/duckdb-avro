query II
SELECT count(*), sum(id) FROM read_avro([
	'test/reader/codec_null.avro',
	'test/reader/codec_deflate.avro',
	'test/reader/codec_snappy.avro',
	'test/reader/codec_zstandard.avro',
	'test/reader/codec_zstandard_no_content_size.avro'
])
----
15000	22492500

statement error
SELECT * FROM read_avro('test/reader/codec_bzip2.avro')
----
Unknown codec bzip2

query III
SELECT count(*), sum(id), list(word ORDER BY id) FROM read_avro('test/reader/codec_zstandard_frames.avro')
----
5	10	[word 0, word 1, word 2, word 3, word 4]

query II
SELECT count(*), sum(n) FROM read_avro('test/reader/codec_zstandard_large.avro')
----
100000	100000
