# name: test/sql/reader/logical_temporal.test
# description: read_avro maps date, time and (local) timestamp logical types to DuckDB types, with NULLs, negative and extreme values
# group: [reader]

require avro

query II
SELECT column_name, column_type FROM (DESCRIBE FROM read_avro('test/reader/logical_temporal.avro'))
----
id	INTEGER
d	DATE
t_ms	TIME
t_us	TIME
ts_ms	TIMESTAMP
ts_us	TIMESTAMP
ts_ns	TIMESTAMP_NS
lts_ms	TIMESTAMP
lts_us	TIMESTAMP
lts_ns	TIMESTAMP_NS

query IIIIIIIIII
